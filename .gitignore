# Root ignore — monorepo hygiene
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo

# Dependencies
node_modules/
**/node_modules/

# Environment secrets (never commit)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Allow shared examples + production public Vite vars (no secrets)
!.env.example
!**/.env.example
!.env.production
!**/.env.production

# Builds
dist/
**/dist/
coverage/
**/coverage/

# Backend uploads & generated data
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/*
!backend/data/.gitkeep
backend/logs/

# Local / OS
npm-debug.log*
yarn-error.log*
