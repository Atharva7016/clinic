# Frontend env — copy to .env for local development.
# Restart `npm run dev` after changing these values.

# Local API (must match backend PORT, default 5001)
# VITE_API_URL=http://localhost:5001/api
VITE_API_URL=https://clinic-backend-h8ex.onrender.com/api

# Production builds use `.env.production` (committed) or set VITE_API_URL
# in the host dashboard (Render/Vercel) before build:
# VITE_API_URL=https://clinic-backend-h8ex.onrender.com/api

# Public site URL (SEO / Open Graph) — optional in local dev
# VITE_SITE_URL=https://clinic-frontend-bx4b.onrender.com

# Optional integrations
# VITE_WHATSAPP_NUMBER=919833829133
# VITE_GOOGLE_MAP_URL=
# VITE_GA_ID=
